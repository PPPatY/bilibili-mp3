{
  "manifest_version": 3,
  "name": "Bilibili MP3 Local (Debug)",
  "version": "1.1.0-debug",
  "description": "调试版本 - 带详细日志",
  "permissions": ["activeTab", "downloads", "storage", "cookies", "tabs"],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://*.bilivideo.com/*",
    "http://127.0.0.1:3000/*"
  ],
  "action": {
    "default_title": "Bilibili MP3 (Debug)",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background-debug.js" },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["batch.html", "batch.css", "batch.js"],
      "matches": ["<all_urls>"]
    }
  ]
}

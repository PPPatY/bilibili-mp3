{
  "manifest_version": 3,
  "name": "Bilibili MP3 Local",
  "version": "0.1.0",
  "description": "将当前 Bilibili 页面中可访问的媒体转换为 MP3（本地使用）",
  "permissions": ["activeTab", "downloads", "storage", "cookies"],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://*.bilivideo.com/*",
    "http://127.0.0.1:3000/*"
  ],
  "action": {
    "default_title": "Bilibili MP3",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
